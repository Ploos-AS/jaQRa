{
  "name": "jaqra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/precache.mjs && npm run test:build",
    "preview": "vite preview",
    "test": "vitest run src && npm run test:precache",
    "test:precache": "node --test scripts/precache.test.mjs",
    "test:build": "node scripts/smoke-build.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
